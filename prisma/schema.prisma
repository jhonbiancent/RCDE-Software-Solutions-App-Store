// prisma/schema.prisma
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model App {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  tagline       String?
  description   String      @db.Text
  platforms     String[]              // ["Android", "iOS", "WebApp"]
  categories    String[]              // ["Business", "Finance", "Games"]
  techStack     String[]              // ["Next.js", "Prisma", "Postgres"]
  liveUrl       String?               // for web apps/websites
  downloadUrl   String?               // for mobile app store/download links
  iconUrl       String?
  screenshots   String[]              // array of image URLs
  status        AppStatus   @default(DRAFT)
  featured      Boolean     @default(false)
  viewCount     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reviews       Review[]
  comments      Comment[]             // FUTURE: only if you drop Giscus for native comments

  @@index([status])
}

model Review {
  id          String   @id @default(cuid())
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  rating      Int                     // 1–5
  body        String?  @db.Text
  authorName  String
  authorImage String?
  authorId    String                  // GitHub user id from OAuth session
  createdAt   DateTime @default(now())

  @@unique([appId, authorId])         // one review per user per app
  @@index([appId])
}

// FUTURE: only needed if you replace Giscus with native comments
model Comment {
  id          String    @id @default(cuid())
  appId       String
  app         App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  body        String    @db.Text
  authorName  String
  authorId    String
  parentId    String?
  createdAt   DateTime  @default(now())

  @@index([appId])
}
