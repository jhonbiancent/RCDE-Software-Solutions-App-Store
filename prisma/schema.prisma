// prisma/schema.prisma
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppCategory {
  WEB_APP
  DESKTOP_APP
  WEBSITE
  MOBILE_APP
  LIBRARY_TOOL
}

enum AppStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model App {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  tagline       String?
  description   String      @db.Text
  caseStudy     String?     @db.Text   // longer portfolio write-up: problem/approach/stack/lessons
  category      AppCategory
  techStack     String[]              // ["Next.js", "Prisma", "Postgres"]
  githubOwner   String?               // for release/download-count lookups
  githubRepo    String?
  liveUrl       String?               // for web apps/websites
  coverImage    String?
  screenshots   String[]              // array of image URLs
  videoUrl      String?               // demo video, e.g. YouTube embed URL
  status        AppStatus   @default(DRAFT)
  featured      Boolean     @default(false)
  viewCount     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reviews       Review[]
  comments      Comment[]             // FUTURE: only if you drop Giscus for native comments

  @@index([status])
  @@index([category])
}

model Review {
  id          String   @id @default(cuid())
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  rating      Int                     // 1–5
  body        String?  @db.Text
  authorName  String
  authorImage String?
  authorId    String                  // GitHub user id from OAuth session
  createdAt   DateTime @default(now())

  @@unique([appId, authorId])         // one review per user per app
  @@index([appId])
}

// FUTURE: only needed if you replace Giscus with native comments
model Comment {
  id          String    @id @default(cuid())
  appId       String
  app         App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  body        String    @db.Text
  authorName  String
  authorId    String
  parentId    String?
  createdAt   DateTime  @default(now())

  @@index([appId])
}
